# Copy to .env.local for local dev. In production (Render), set this as a
# build-time environment variable on the frontend service instead — Next.js
# inlines NEXT_PUBLIC_* vars at build time, so it must be set before "next build"
# runs, not just at start.

# Backend API origin, no trailing slash. Defaults to http://localhost:8080 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8080
